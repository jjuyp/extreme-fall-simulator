    "three": "^0.185.1",
    "zustand": "^5.0.11"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  }
