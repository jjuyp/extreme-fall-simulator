{
  "name": "extreme-fall-simulator",
  "version": "0.1.0",
  "description": "Traditional Chinese 3D fall physics sandbox",
  "scripts": {
    "test": "node --test tests/physics.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
